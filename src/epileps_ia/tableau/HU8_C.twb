        <calculation class='tableau' formula='IF [forma_farmaceutica_simplificada_capsula] = 1 THEN &quot;Cápsula&quot;&#13;&#10;ELSEIF [forma_farmaceutica_simplificada_comprimido] = 1 THEN &quot;Comprimido&quot;&#13;&#10;ELSEIF [forma_farmaceutica_simplificada_comprimido_liberacion_modificada] = 1 THEN &quot;Comprimido liberación modificada&quot;&#13;&#10;ELSEIF [forma_farmaceutica_simplificada_comprimido_masticable] = 1 THEN &quot;Comprimido masticable&quot;&#13;&#10;ELSEIF [forma_farmaceutica_simplificada_gel_pasta_liquido_bucal] = 1 THEN &quot;Gel bucal&quot;&#13;&#10;ELSEIF [forma_farmaceutica_simplificada_inyectable] = 1 THEN &quot;Inyectable&quot;&#13;&#10;ELSEIF [forma_farmaceutica_simplificada_solucion_suspension_gotas_orales] = 1 THEN &quot;Gotas orales&quot;&#13;&#10;ELSEIF [forma_farmaceutica_simplificada_solucion_suspension_oral] = 1 THEN &quot;Solución oral&quot;&#13;&#10;END' />
      </column>
      <column caption='C_Sin foto' datatype='boolean' name='[Calculation_1575052733730825]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='ISNULL([url_foto_materiales])' />
      </column>
      <column caption='C_Texto sin foto' datatype='string' name='[Calculation_1575052733853706]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;Imagen no disponible para este medicamento&quot;' />
