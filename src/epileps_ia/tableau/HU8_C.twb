      <column caption='C_Ficha texto' datatype='string' name='[Calculation_1575052739698699]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[nombre] + CHAR(10) + CHAR(10) +&#13;&#10;&quot;Principio activo: &quot; + [pactivos] + CHAR(10) +&#13;&#10;&quot;Laboratorio: &quot; + [labtitular] + CHAR(10) +&#13;&#10;&quot;Dosis: &quot; + STR([dosis]) + &quot; &quot; + [dosis_unidad] + CHAR(10) +&#13;&#10;&quot;Forma: &quot; + [Calculation_1575052702449672] + CHAR(10) +&#13;&#10;&quot;Precio: &quot; + STR([precio_venta_al_publico_con_iva]) + &quot; €&quot; + CHAR(10) +&#13;&#10;&quot;Genérico: &quot; + IIF([generico] = 1, &quot;Sí&quot;, &quot;No&quot;) + CHAR(10) +&#13;&#10;&quot;Comercializado: &quot; + IIF([comercializado] = 1, &quot;Sí&quot;, &quot;No&quot;) + CHAR(10) +&#13;&#10;&quot;Perfil: &quot; + [perfil]' />
      </column>
      <column caption='C_Texto enlace' datatype='string' name='[Calculation_1575052920979468]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;Abrir la ficha técnica en CIMA →&quot;' />
