    <worksheet name='C4 Datos'>
      <table>
        <view>
          <datasources>
            <datasource caption='EpilepsIA MySQL' name='federated.1ip3snt0b2meux1f6gt4w0e9dbup' />
          </datasources>
          <datasource-dependencies datasource='federated.1ip3snt0b2meux1f6gt4w0e9dbup'>
            <column caption='Forma farmacéutica' datatype='string' name='[Calculation_1575052702449672]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [forma_farmaceutica_simplificada_capsula] = 1 THEN &quot;Cápsula&quot;&#13;&#10;ELSEIF [forma_farmaceutica_simplificada_comprimido] = 1 THEN &quot;Comprimido&quot;&#13;&#10;ELSEIF [forma_farmaceutica_simplificada_comprimido_liberacion_modificada] = 1 THEN &quot;Comprimido liberación modificada&quot;&#13;&#10;ELSEIF [forma_farmaceutica_simplificada_comprimido_masticable] = 1 THEN &quot;Comprimido masticable&quot;&#13;&#10;ELSEIF [forma_farmaceutica_simplificada_gel_pasta_liquido_bucal] = 1 THEN &quot;Gel bucal&quot;&#13;&#10;ELSEIF [forma_farmaceutica_simplificada_inyectable] = 1 THEN &quot;Inyectable&quot;&#13;&#10;ELSEIF [forma_farmaceutica_simplificada_solucion_suspension_gotas_orales] = 1 THEN &quot;Gotas orales&quot;&#13;&#10;ELSEIF [forma_farmaceutica_simplificada_solucion_suspension_oral] = 1 THEN &quot;Solución oral&quot;&#13;&#10;END' />
            </column>
            <column caption='C_Ficha texto' datatype='string' name='[Calculation_1575052739698699]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[nombre] + CHAR(10) + CHAR(10) +&#13;&#10;&quot;Principio activo: &quot; + [pactivos] + CHAR(10) +&#13;&#10;&quot;Laboratorio: &quot; + [labtitular] + CHAR(10) +&#13;&#10;&quot;Dosis: &quot; + STR([dosis]) + &quot; &quot; + [dosis_unidad] + CHAR(10) +&#13;&#10;&quot;Forma: &quot; + [Calculation_1575052702449672] + CHAR(10) +&#13;&#10;&quot;Precio: &quot; + STR([precio_venta_al_publico_con_iva]) + &quot; €&quot; + CHAR(10) +&#13;&#10;&quot;Genérico: &quot; + IIF([generico] = 1, &quot;Sí&quot;, &quot;No&quot;) + CHAR(10) +&#13;&#10;&quot;Comercializado: &quot; + IIF([comercializado] = 1, &quot;Sí&quot;, &quot;No&quot;) + CHAR(10) +&#13;&#10;&quot;Perfil: &quot; + [perfil]' />
            </column>
            <column caption='Comercializado' datatype='real' name='[comercializado]' role='measure' type='quantitative' />
            <column caption='Dosis' datatype='real' name='[dosis]' role='measure' type='quantitative' />
            <column caption='Dosis Unidad' datatype='string' name='[dosis_unidad]' role='dimension' type='nominal' />
            <column caption='Forma Farmaceutica Simplificada Capsula' datatype='integer' name='[forma_farmaceutica_simplificada_capsula]' role='measure' type='quantitative' />
            <column caption='Forma Farmaceutica Simplificada Comprimido' datatype='integer' name='[forma_farmaceutica_simplificada_comprimido]' role='measure' type='quantitative' />
            <column caption='Forma Farmaceutica Simplificada Comprimido Liberacion Modificada' datatype='integer' name='[forma_farmaceutica_simplificada_comprimido_liberacion_modificada]' role='measure' type='quantitative' />
            <column caption='Forma Farmaceutica Simplificada Comprimido Masticable' datatype='integer' name='[forma_farmaceutica_simplificada_comprimido_masticable]' role='measure' type='quantitative' />
            <column caption='Forma Farmaceutica Simplificada Gel Pasta Liquido Bucal' datatype='integer' name='[forma_farmaceutica_simplificada_gel_pasta_liquido_bucal]' role='measure' type='quantitative' />
            <column caption='Forma Farmaceutica Simplificada Inyectable' datatype='integer' name='[forma_farmaceutica_simplificada_inyectable]' role='measure' type='quantitative' />
            <column caption='Forma Farmaceutica Simplificada Solucion Suspension Gotas Orales' datatype='integer' name='[forma_farmaceutica_simplificada_solucion_suspension_gotas_orales]' role='measure' type='quantitative' />
            <column caption='Forma Farmaceutica Simplificada Solucion Suspension Oral' datatype='integer' name='[forma_farmaceutica_simplificada_solucion_suspension_oral]' role='measure' type='quantitative' />
            <column caption='Generico' datatype='real' name='[generico]' role='measure' type='quantitative' />
            <column caption='Labtitular' datatype='string' name='[labtitular]' role='dimension' type='nominal' />
            <column caption='Nombre' datatype='string' name='[nombre]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_1575052739698699]' derivation='None' name='[none:Calculation_1575052739698699:nk]' pivot='key' type='nominal' />
            <column-instance column='[record_id]' derivation='None' name='[none:record_id:ok]' pivot='key' type='ordinal' />
            <column caption='Pactivos' datatype='string' name='[pactivos]' role='dimension' type='nominal' />
            <column caption='Perfil' datatype='string' name='[perfil]' role='dimension' type='nominal' />
            <column caption='Precio Venta Al Publico Con Iva' datatype='real' name='[precio_venta_al_publico_con_iva]' role='measure' type='quantitative' />
            <column caption='Record Id' datatype='integer' name='[record_id]' role='dimension' type='ordinal' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Text' />
