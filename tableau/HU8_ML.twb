      <aliases enabled='yes' />
      <column caption='Forma farmacéutica' datatype='string' name='[Calculation_0563776882380800]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [forma_farmaceutica_simplificada_capsula] = 1 THEN &quot;Cápsula&quot;&#13;&#10;ELSEIF [forma_farmaceutica_simplificada_comprimido] = 1 THEN &quot;Comprimido&quot;&#13;&#10;ELSEIF [forma_farmaceutica_simplificada_comprimido_liberacion_modificada] = 1 THEN &quot;Comprimido liberación modificada&quot;&#13;&#10;ELSEIF [forma_farmaceutica_simplificada_comprimido_masticable] = 1 THEN &quot;Comprimido masticable&quot;&#13;&#10;ELSEIF [forma_farmaceutica_simplificada_gel_pasta_liquido_bucal] = 1 THEN &quot;Gel bucal&quot;&#13;&#10;ELSEIF [forma_farmaceutica_simplificada_inyectable] = 1 THEN &quot;Inyectable&quot;&#13;&#10;ELSEIF [forma_farmaceutica_simplificada_solucion_suspension_gotas_orales] = 1 THEN &quot;Gotas orales&quot;&#13;&#10;ELSEIF [forma_farmaceutica_simplificada_solucion_suspension_oral] = 1 THEN &quot;Solución oral&quot;&#13;&#10;END' />
      </column>
      <column caption='Estado' datatype='string' name='[Calculation_0563776882655233]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [estado_alta] = 1 THEN &quot;Alta&quot;&#13;&#10;ELSEIF [estado_baja_general] = 1 THEN &quot;Baja general&quot;&#13;&#10;ELSEIF [estado_baja_por_no_comercializar] = 1 THEN &quot;Baja por no comercializar&quot;&#13;&#10;ELSEIF [estado_suspension_temporal_general] = 1 THEN &quot;Suspensión temporal&quot;&#13;&#10;END' />
      </column>
      <column caption='Tipo (genérico o marca)' datatype='string' name='[Calculation_0563776882794498]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [generico] = 1 THEN &quot;Genérico&quot; ELSE &quot;Marca&quot; END' />
      </column>
      <column caption='Comercialización' datatype='string' name='[Calculation_0563776882954243]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [comercializado] = 1 THEN &quot;Comercializado&quot; ELSE &quot;No comercializado&quot; END' />
      </column>
      <column caption='Nº medicamentos' datatype='integer' name='[Calculation_0563776883052548]' role='measure' type='quantitative'>
